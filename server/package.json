{
  "name": "race-control-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "predeploy": "npm run site:build --prefix ..",
    "deploy": "wrangler deploy",
    "db:migrate:remote": "wrangler d1 migrations apply race-control --remote",
    "crews:import": "tsx scripts/importCrews.ts",
    "cars:import": "tsx scripts/importCars.ts",
    "tracks:import": "tsx scripts/importTracks.ts",
    "translation:try": "tsx scripts/tryTranslation.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.40.0"
  }
}
